{
  "name": "@complyos/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --no-eslintrc --config ../../.eslintrc.foundation.cjs src --ext .ts"
  },
  "dependencies": {
    "bullmq": "^5.58.0",
    "ioredis": "^5.7.0",
    "pino": "^9.9.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "5.2.2",
    "@types/pg": "^8.15.5"
  }
}
