# Copy this file to apps/api/.env and supply your local database credentials.
# The API loads only this workspace's .env; process variables take precedence.
NODE_ENV=development
PORT=4000

# Required PostgreSQL connection URL. Replace the sample credentials.
# This step validates the URL only; Prisma connectivity is implemented in T0014.
DATABASE_URL=postgresql://complyos:replace_me@127.0.0.1:5432/complyos_dev
