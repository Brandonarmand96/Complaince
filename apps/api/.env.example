# Copy this file to apps/api/.env and supply your provider connection URLs.
# The API loads only this workspace's .env; process variables take precedence.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
QUEUE_PREFIX=complyos
ACCESS_JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_JWT_ISSUER=complyos-api
ACCESS_JWT_AUDIENCE=complyos-web
ACCESS_JWT_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Required. Keep your provider's TLS/query parameters, for example sslmode=require.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Required. Use rediss:// when your provider requires TLS.
# Format: rediss://default:PASSWORD@HOST:6379/0
# Supply a Redis protocol URL, not an HTTPS REST endpoint.
REDIS_URL=
